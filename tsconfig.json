{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": false,
    "declaration": false,
    "noEmit": true,
    // TypeScript 6.0 deprecates `baseUrl` (still functional). We keep `baseUrl` + `paths`
    // for the `@/*` alias used throughout the framework. When ready to migrate, replace
    // both with a `package.json` "imports" map (e.g. "#/*": "./src/*") — Node-native, no
    // tsconfig path resolution needed — and rewrite `@/...` imports to `#/...`.
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "types": ["node"]
  },
  "include": ["src/**/*", "tests/**/*", "playwright.config.ts"],
  "exclude": ["node_modules", "playwright-report", "test-results", "dist"]
}
